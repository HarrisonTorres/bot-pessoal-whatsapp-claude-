# Copie este arquivo para .env e preencha com seus valores reais.
# O .env real esta no .gitignore e nunca vai para o repositorio.

# JID do SEU numero principal. Somente mensagens dele sao processadas.
# Formato: codigo do pais + DDD + numero, sem "+" nem espacos.
OWNER_JID=5500000000000@s.whatsapp.net

# Pasta de estado local (sessao do WhatsApp, bancos, midia, outbox, logs)
BOT_DATA_DIR=./data

# Fuso horario usado nas datas dos gastos e relatorios
TZ=America/Sao_Paulo

# Modelo do Whisper para transcrever audios (tiny | base | small | medium)
WHISPER_MODEL=small
