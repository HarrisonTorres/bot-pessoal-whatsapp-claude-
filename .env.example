# Copie este arquivo para .env e preencha com seus valores reais.
# O .env real esta no .gitignore e nunca vai para o repositorio.

# JID do SEU numero principal. Usado apenas em grupos marcados com "somenteDono": true
# no config/groups.json; nos outros grupos qualquer membro e atendido. Pode ficar vazio.
# Formato: codigo do pais + DDD + numero, sem "+" nem espacos.
OWNER_JID=5500000000000@s.whatsapp.net

# Pasta de estado local (sessao do WhatsApp, bancos, midia, outbox, logs)
BOT_DATA_DIR=./data

# Fuso horario usado nas datas dos gastos e relatorios
TZ=America/Sao_Paulo

# Modelo do Whisper para transcrever audios (tiny | base | small | medium)
WHISPER_MODEL=small

# Opcionais
# JID do dono no formato LID (so importa em grupos com "somenteDono": true), se os logs
# mostrarem "sender-not-owner" com um id @lid seu
# OWNER_LID=000000000000000@lid
# Pasta da sessão do WhatsApp fora do repositório (recomendado se o teste de segurança falhar)
# WA_AUTH_DIR=C:\Users\SEU_USUARIO\AppData\Local\wa-claude\auth
# Config dedicada do Claude Code para o bot (opcional: o --restricted do spike já isola o bot)
# CLAUDE_CONFIG_DIR=C:\Users\SEU_USUARIO\wa-claude\data\claude-config
# Caminho do executável do claude, se não estiver no PATH
# CLAUDE_BIN=claude
# Python do venv do transcritor (padrão: transcriber\.venv\Scripts\python.exe)
# TRANSCRIBER_PYTHON=
